# Server
PORT=5000

# MongoDB Atlas — Render par edits persist karne ke liye zaroori
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/nehal-portfolio?retryWrites=true&w=majority

# JWT — lambi random string (32+ characters)
JWT_SECRET=your-long-random-jwt-secret-min-32-chars

# Admin login — Render env me set karo (plain password ya bcrypt hash dono chalega)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password

# CORS — local + production (comma separated, no trailing slash needed)
CLIENT_ORIGIN=http://localhost:5173,https://your-app.onrender.com

# Frontend API — leave blank for local Vite proxy; set this on Vercel to the Render backend URL
VITE_API_URL=

# Cloudinary — file uploads ke liye (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=nehal-portfolio
